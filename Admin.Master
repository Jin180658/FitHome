<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="FitHome.Admin" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>FitHome - Admin Panel</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        /* Define brand colors from logo */
        :root {
            --fh-navy: #002d5a;
            --fh-orange: #ff9d00;
            --fh-bg: #f4f7f6;
        }

        body {
            background-color: var(--fh-bg);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow-x: hidden;
        }

        /* Flex layout for the entire page wrapper */
        .admin-wrapper {
            display: flex;
            min-height: 100vh;
        }

        /* Left Sidebar Styles */
        .sidebar {
            width: 260px;
            background-color: var(--fh-navy);
            color: white;
            transition: all 0.3s;
            box-shadow: 4px 0 10px rgba(0,0,0,0.1);
            z-index: 1000;
        }

        /* Logo area inside the sidebar */
        .sidebar-header {
            padding: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            margin-bottom: 20px;
        }
        
        /* UPGRADED: Added border-radius to make the logo smooth and rounded */
        .sidebar-header img {
            max-width: 150px;
            margin-bottom: 10px;
            border-radius: 18px; /* Smooth corners */
            box-shadow: 0 4px 8px rgba(0,0,0,0.15); /* Soft shadow for 3D effect */
        }

        /* Navigation links inside the sidebar */
        .sidebar-nav .nav-link {
            color: rgba(255, 255, 255, 0.7);
            padding: 15px 25px;
            font-size: 1.05rem;
            border-left: 4px solid transparent;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
        }

        .sidebar-nav .nav-link i {
            margin-right: 15px;
            font-size: 1.2rem;
            width: 20px;
            text-align: center;
        }

        /* Hover and active states: Orange accent */
        .sidebar-nav .nav-link:hover, 
        .sidebar-nav .nav-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.05);
            border-left: 4px solid var(--fh-orange);
        }

        /* UPGRADED: Logged-in admin info section styles */
        .admin-profile {
            padding: 15px 25px;
            color: rgba(255, 255, 255, 0.6);
            font-size: 0.85rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 5px;
        }

        /* Special styling for the logout button */
        .logout-btn {
            color: #ff6b6b !important;
        }
        .logout-btn:hover {
            background-color: rgba(255, 107, 107, 0.1) !important;
            border-left-color: #ff6b6b !important;
        }

        /* Right Main Content Area */
        .main-content {
            flex-grow: 1;
            padding: 30px;
            width: calc(100% - 260px); /* Ensure tables do not push the sidebar */
        }

        /* Top navigation bar (for title and clock) */
        .top-navbar {
            background: white;
            padding: 15px 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            margin-bottom: 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-navbar h4 {
            margin: 0;
            color: var(--fh-navy);
            font-weight: bold;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="admin-wrapper">
            
            <nav class="sidebar d-flex flex-column">
                <div class="sidebar-header">
                    <img src="assets/img/logo.png" alt="FitHome Logo" class="img-fluid" />
                    <div class="text-white-50 small mt-2">Admin Workspace</div>
                </div>

                <div class="sidebar-nav flex-grow-1 mt-3">
                    <a href="AdminDashboard.aspx" class="nav-link text-decoration-none">
                        <i class="fas fa-chart-pie"></i> Dashboard
                    </a>
                    <a href="ManageCourses.aspx" class="nav-link text-decoration-none">
                        <i class="fas fa-video"></i> Manage Courses
                    </a>
                    <a href="AdminManageQuiz.aspx" class="nav-link text-decoration-none">
                        <i class="fas fa-tasks"></i> Manage Quizzes
                    </a>
                    <a href="ManageUsers.aspx" class="nav-link text-decoration-none">
                        <i class="fas fa-users"></i> Registered Users
                    </a>
                </div>

                <div class="mt-auto mb-3">
                    
                    <div class="admin-profile">
                        <i class="fas fa-user-shield text-warning me-2"></i>Logged in as:<br />
                        <span class="text-white fw-bold" style="font-size: 1rem; margin-left: 28px;">
                            <%= Session["AdminName"] != null ? Session["AdminName"].ToString() : "Admin" %>
                        </span>
                    </div>

                    <div class="sidebar-nav">
                        <asp:LinkButton ID="btnLogout" runat="server" CssClass="nav-link text-decoration-none logout-btn" OnClick="btnLogout_Click">
                            <i class="fas fa-sign-out-alt"></i> Secure Logout
                        </asp:LinkButton>
                    </div>
                </div>
            </nav>

            <div class="main-content">
                
                <div class="top-navbar">
                    <h4><i class="fas fa-shield-alt text-warning me-2"></i> Administrator Panel</h4>
                    <span class="text-muted"><i class="fas fa-clock me-1"></i> <span id="clock"></span></span>
                </div>

                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                </asp:ContentPlaceHolder>
                
            </div>
        </div>
    </form>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        function updateClock() {
            var now = new Date();
            document.getElementById('clock').innerText = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
</body>
</html>