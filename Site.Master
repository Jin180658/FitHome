<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="FitHome.Site" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <style>
        :root {
            --bg-color: #f4f6f9;
            --text-color: #333333;  
            --hero-text-color: #222222;
            --card-bg: rgba(255, 255, 255, 0.95);
            --border-color: #eeeeee; 
            
            --hero-bg-blend: normal; 
            --hero-overlay-color: rgba(255, 255, 255, 0);
        }

        [data-theme="dark"] {
            --bg-color: #121212; 
            --text-color: #e0e0e0; 
            --hero-text-color: #f0f0f0;
            --card-bg: rgba(30, 30, 30, 0.85);
            --border-color: #444444;   

            --hero-bg-blend: luminosity; 
            --hero-overlay-color: rgba(0, 0, 0, 0.6); 
        }
        [data-theme="dark"] .card, 
        [data-theme="dark"] .bg-white, 
        [data-theme="dark"] .bg-light, 
        [data-theme="dark"] .panel, 
        [data-theme="dark"] .box,
        [data-theme="dark"] .modal-content,
        [data-theme="dark"] table, 
        [data-theme="dark"] th, 
        [data-theme="dark"] td 
        [data-theme="dark"] .info-card,
        [data-theme="dark"] .login-card,
        [data-theme="dark"] .register-card,
        [data-theme="dark"] .course-card,
        [data-theme="dark"] .item-box,
        [data-theme="dark"] .white-box,
        [data-theme="dark"] .content-box 
        [data-theme="dark"] div, 
        [data-theme="dark"] section, 
        [data-theme="dark"] aside {
            background-color: var(--card-bg) !important;
            border-color: var(--border-color) !important;
            color: var(--text-color) !important;
        }

        [data-theme="dark"] h1, 
        [data-theme="dark"] h2, 
        [data-theme="dark"] h3, 
        [data-theme="dark"] h4, 
        [data-theme="dark"] h5, 
        [data-theme="dark"] h6, 
        [data-theme="dark"] p, 
        [data-theme="dark"] span, 
        [data-theme="dark"] label, 
        [data-theme="dark"] li, 
        [data-theme="dark"] div {
            color: var(--text-color) !important;
        }

        [data-theme="dark"] input[type="text"], 
        [data-theme="dark"] input[type="password"], 
        [data-theme="dark"] input[type="email"], 
        [data-theme="dark"] textarea, 
        [data-theme="dark"] select,
        [data-theme="dark"] .form-control {
            background-color: #2a2a2a !important;
            color: #ffffff !important;
            border: 1px solid #444444 !important;
        }

        [data-theme="dark"] .btn,
        [data-theme="dark"] input[type="submit"],
        [data-theme="dark"] button {
            color: #ffffff !important; 
        }

        body {
            background-color: var(--bg-color) !important; 
            color: var(--text-color) !important;
            transition: background-color 0.4s ease, color 0.4s ease;
        }

        .body-content, form {
            background-color: transparent !important; 
        }

        .theme-toggle-container {
            float: right; 
            margin-right: 20px;
            display: flex; align-items: center; height: 100%;
        }
        .theme-toggle-btn {
            background: none; border: none; cursor: pointer;
            font-size: 1.4rem; outline: none; padding: 5px;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .theme-toggle-btn:hover { transform: scale(1.2) rotate(15deg); }
    </style>

    <script>
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>

    <script>
        if (localStorage.getItem('theme') === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
        }
    </script>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <title>FitHome Academy</title>
    
    <link href="assets/img/logo.png" rel="icon">
    
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

    <link href="assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
    <link href="assets/vendor/aos/aos.css" rel="stylesheet">
    <link href="assets/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">

    <link href="assets/css/main.css" rel="stylesheet">
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>

<body class="index-page">
    <form id="form1" runat="server">
        
        <header id="header" class="header d-flex align-items-center sticky-top">
            <div class="container-fluid container-xl position-relative d-flex align-items-center">
                
                <a href="Default.aspx" class="logo d-flex align-items-center me-auto">
                    <h1 class="sitename">FitHome</h1>
                </a>

<div class="header-profile d-flex align-items-center me-3 me-xl-4 pe-3 border-end border-secondary-subtle">
                    
                    <asp:Panel ID="pnlGuest" runat="server" Visible="true">
                        <a href="Login.aspx" class="d-flex align-items-center text-decoration-none" title="Login">
                            <i class="bi bi-person-circle fs-2 text-white"></i>
                            <span class="ms-2 fw-bold text-white d-none d-sm-block">Guest</span>
                        </a>
                    </asp:Panel>

                    <asp:Panel ID="pnlLoggedIn" runat="server" Visible="false">
                        <a href="UserDashboard.aspx" class="d-flex align-items-center text-decoration-none" title="Go to Dashboard">
                            <img src="assets/img/profiles/defaultUser.png" alt="Profile" id="imgProfilePic" runat="server" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" />
                            <span class="ms-2 fw-bold text-dark d-none d-md-block" id="lblUserName" runat="server">Username</span>
                        </a>
                    </asp:Panel>

                </div>

                <nav id="navmenu" class="navmenu">
                    <ul>
                        <li><a href="Default.aspx">Home</a></li>
                        <li><a href="About.aspx">About</a></li>
                        <li><a href="CourseCatalog.aspx">Courses</a></li>
                        <li id="navForum" runat="server" visible="false"><a href="CommunityBoard.aspx">Forum</a></li>
                        <li id="navFavorites" runat="server" visible="false"><a href="MyFavorites.aspx">My Favorites</a></li>
                        <li style="display: flex; align-items: center; padding-left: 20px;">
                        <button type="button" id="theme-toggle" style="background: none; border: none; font-size: 1.4rem; cursor: pointer; outline: none;">🌙</button>
                        </li>
                    </ul>

                    <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
 
 
                </nav>
                </div>
        </header>

        <div>
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer id="footer" class="footer accent-background">
            <div class="container footer-top">
                <div class="row gy-4">
                    <div class="col-lg-5 col-md-12 footer-about">
                        <a href="Default.aspx" class="logo d-flex align-items-center text-decoration-none">
                            <span class="sitename">FitHome</span>
                        </a>
                        <p>FitHome Academy - Your partner in home fitness.</p>
                    </div>
                </div>
            </div>
            
            <div class="container copyright text-center mt-4 pb-3">
                <p class="mb-2">© <span>Copyright</span> <strong class="px-1 sitename">FitHome</strong> <span>All Rights Reserved</span></p>
                
                <div class="admin-portal-link mt-2">
                    <a href="AdminLogin.aspx" class="text-decoration-none" style="color: rgba(255, 255, 255, 0.5); font-size: 0.85rem; transition: color 0.3s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='rgba(255, 255, 255, 0.5)'">
                        <i class="bi bi-shield-lock me-1"></i> Authorized Admin Access
                    </a>
                </div>
            </div>
        </footer>

    </form> 

    <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>
    <div id="preloader"></div>

    <script src="assets/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="assets/vendor/php-email-form/validate.js"></script>
    <script src="assets/vendor/aos/aos.js"></script>
    <script src="assets/vendor/purecounter/purecounter_vanilla.js"></script>
    <script src="assets/vendor/swiper/swiper-bundle.min.js"></script>
    
    <script src="assets/js/main.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let currentPath = window.location.pathname.split('/').pop();
            if (currentPath === '') currentPath = 'Default.aspx';

            let navLinks = document.querySelectorAll('.navmenu ul li a');

            navLinks.forEach(link => {
                link.classList.remove('active');

                let href = link.getAttribute('href');
                if (href && href.toLowerCase() === currentPath.toLowerCase()) {
                    link.classList.add('active');
                }
            });
        });
    </script>
    <script>
        const toggleBtn = document.getElementById('theme-toggle');
        const root = document.documentElement;

        if (localStorage.getItem('theme') === null) {
            localStorage.setItem('theme', 'light');
        }

        if (localStorage.getItem('theme') === 'dark') {
            root.setAttribute('data-theme', 'dark');
            toggleBtn.innerHTML = '☀️';
        } else {
            root.removeAttribute('data-theme');
            toggleBtn.innerHTML = '🌙';
        }

        toggleBtn.addEventListener('click', () => {
            let currentTheme = root.getAttribute('data-theme');

            if (currentTheme === 'dark') {
                root.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                toggleBtn.innerHTML = '🌙';
            } else {
                root.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                toggleBtn.innerHTML = '☀️';
            }
        });
    </script>
    
</body>
</html>